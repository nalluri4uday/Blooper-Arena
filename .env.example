# Database (Neon)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/blooperarena?sslmode=require
DATABASE_URL_POOLED=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/blooperarena?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=your-random-32-char-secret-here
BETTER_AUTH_URL=http://localhost:3000

# OAuth (Google) - optional for MVP
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker
WORKER_API_KEY=your-random-api-key-for-admin-endpoints
WORKER_PORT=3001

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
