# Database (Neon)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_POOLED=postgresql://user:pass@host-pooler/db?sslmode=require

# Auth
BETTER_AUTH_SECRET=generate-a-random-64-char-string
